<Window x:Class="FloatBrowser.BrowserWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="浮光 · 悬浮浏览器" Icon="Assets/App.ico" Width="1180" Height="790" MinWidth="160" MinHeight="90" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="#111B21" ResizeMode="CanResizeWithGrip" UseLayoutRounding="True" SnapsToDevicePixels="True" FontFamily="Microsoft YaHei UI">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="5" CornerRadius="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
 <Border x:Name="WindowFrame" Background="#111B21" BorderBrush="#37454B" BorderThickness="1" CornerRadius="12">
  <Grid x:Name="WindowLayout" Margin="1">
   <Grid.RowDefinitions><RowDefinition x:Name="TitleRow" Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid x:Name="TitleBar" Background="Transparent" MouseLeftButtonDown="DragTitle">
    <StackPanel Orientation="Horizontal" Margin="8,0,64,0" VerticalAlignment="Center"><Button x:Name="ToolsToggle" Content="☰ 工具" Visibility="Collapsed" Click="ToolsClick" Padding="8,3" Margin="0,0,8,0" ToolTip="点击展开 / 收起工具栏"/><Image Source="Assets/App.ico" Width="21" Height="21" Margin="0,0,8,0"/><TextBlock x:Name="Brand" Text="浮光" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="Tagline" Text=" /  FLOAT BROWSER" MaxWidth="400" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="#80928F" VerticalAlignment="Center" Margin="8,0"/></StackPanel>
    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,4,9,4"><Button x:Name="RestoreAd" Content="恢复窗口 ↗" Click="AdClick" Visibility="Collapsed" Padding="8,2" Margin="3,0" FontSize="11"/><Button x:Name="HideButton" Content="—" ToolTip="隐藏到托盘（老板键可召回）" Click="HideClick" Background="Transparent" Padding="10,0" Margin="3,0" FontSize="14"/><Button x:Name="CloseButton" Content="×" ToolTip="关闭当前窗口；最后一个窗口关闭时退出程序" Click="CloseClick" Background="Transparent" FontSize="18" Padding="11,0" Margin="3,0"/></StackPanel>
   </Grid>
   <Popup x:Name="CompactTools" Placement="Center" PlacementTarget="{Binding ElementName=ShellBody}" AllowsTransparency="True" StaysOpen="True" PopupAnimation="None">
    <Border x:Name="CompactToolsRoot" Width="420" Height="600" Background="#162229" BorderBrush="#56736D" BorderThickness="1" CornerRadius="8" Padding="8">
     <DockPanel>
      <Grid DockPanel.Dock="Top" Margin="6,2,2,6"><TextBlock Text="浏览工具" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="收起 ×" HorizontalAlignment="Right" Click="CloseCompactTools" ToolTip="收起工具，继续浏览"/></Grid>
      <Grid x:Name="CompactToolsContent">
       <ScrollViewer x:Name="CompactToolsScroll" PreviewMouseWheel="ScrollCompactTools" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="CompactToolsStack"/></ScrollViewer>
      </Grid>
     </DockPanel>
    </Border>
   </Popup>
   <Grid Grid.Row="1" x:Name="ShellBody">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="Sidebar" Background="#142027" BorderBrush="#29373D" BorderThickness="0,1,1,0" Padding="12,18,12,14">
     <DockPanel>
      <StackPanel x:Name="SidebarInfo" DockPanel.Dock="Bottom"><Border Background="#1D302F" CornerRadius="8" Padding="12" Margin="0,12,0,0"><StackPanel><TextBlock Text="●  数据留在本机" Foreground="#8FCEB9" FontSize="11"/><TextBlock Text="登录状态 · 收藏 · 历史" Foreground="#7F9796" FontSize="10" Margin="0,6,0,0"/></StackPanel></Border><TextBlock Text="WEBVIEW2  /  1.0" Foreground="#536A72" FontSize="9" Margin="12,17,0,0"/></StackPanel>
      <ScrollViewer x:Name="SidebarScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
       <TextBlock Text="工作空间" Foreground="#667F87" FontSize="10" Margin="12,0,0,12"/>
       <Button Content="⌂   起始页" Click="HomeClick" HorizontalContentAlignment="Left" Background="#24403B" Foreground="#9CE5CB"/>
       <Button Content="☆   我的收藏" Click="FavoritesClick" Background="Transparent"/>
       <Button Content="◷   最近访问" Click="HistoryClick" Background="Transparent"/>
       <Border Height="1" Background="#29383E" Margin="12,19"/>
       <Grid Margin="12,0,8,8"><TextBlock Text="悬浮窗口" Foreground="#667F87" FontSize="10"/><TextBlock x:Name="WindowCount" Text="1 / 5" HorizontalAlignment="Right" Foreground="#8EAAA7" FontSize="10"/></Grid>
       <StackPanel x:Name="WindowList"/>
       <Button x:Name="NewButton" Content="＋   新建窗口" Click="NewClick" Background="Transparent" Foreground="#8BD7BD" Margin="3,8"/>
       <Border Height="1" Background="#29383E" Margin="12,14"/>
       <Button Content="⚙   快捷键与设置" Click="SettingsClick" Background="Transparent"/>
      </StackPanel></ScrollViewer>
     </DockPanel>
    </Border>
    <Grid Grid.Column="1" x:Name="MainContent">
     <Grid.RowDefinitions><RowDefinition x:Name="ToolbarRow" Height="62"/><RowDefinition Height="*"/><RowDefinition x:Name="FooterRow" Height="Auto"/></Grid.RowDefinitions>
     <Grid x:Name="Toolbar" Margin="12,9,12,9">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel x:Name="NavigationButtons" Orientation="Horizontal"><Button x:Name="BackButton" Content="←" Click="BackClick" ToolTip="后退" Background="Transparent"/><Button x:Name="ForwardButton" Content="→" Click="ForwardClick" ToolTip="前进" Background="Transparent"/><Button Content="↻" Click="ReloadClick" ToolTip="刷新" Background="Transparent"/></StackPanel>
      <TextBox Grid.Column="1" x:Name="Address" KeyDown="AddressKey" AutomationProperties.Name="网址或搜索" ToolTip="输入网址或搜索，按 Enter 打开" Margin="8,2"/>
      <StackPanel x:Name="ToolbarActions" Grid.Column="2" Orientation="Horizontal"><Button x:Name="FavoriteButton" Content="☆" Click="FavoriteClick" ToolTip="收藏当前页面" Background="Transparent" FontSize="18"/><Button x:Name="MoreButton" Content="•••" Click="MoreClick" ToolTip="更多" Background="Transparent"/></StackPanel>
     </Grid>
     <Grid Grid.Row="1" x:Name="BrowserHost" Background="#101A20">
      <wv:WebView2 x:Name="Web" DefaultBackgroundColor="#101A20"/>
      <Border x:Name="Loading" Background="#142027"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="◈" FontSize="42" Foreground="#96E3C6" HorizontalAlignment="Center"/><TextBlock x:Name="LoadingText" Text="正在准备你的悬浮空间…" Margin="0,20" Foreground="#8B9EA5" TextWrapping="Wrap" MaxWidth="520"/></StackPanel></Border>
     </Grid>
     <Border x:Name="Footer" Grid.Row="2" MinHeight="86" BorderThickness="0,1,0,0" BorderBrush="#2C393F" Padding="16,10,16,9">
      <StackPanel>
       <WrapPanel VerticalAlignment="Center">
        <Button x:Name="PinButton" Content="● 已置顶" Click="PinClick" Background="#243C36" Foreground="#A0E6CB" Padding="10,7"/>
        <TextBlock Text="全局透明度" FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#8B9AA7"/><Slider x:Name="OpacitySlider" Minimum="10" Maximum="100" Width="88" Value="100" ValueChanged="OpacityChanged"/><TextBlock x:Name="OpacityText" Text="100%" FontSize="11" Width="36" VerticalAlignment="Center"/>
        <Button x:Name="ZoomButton" Content="100% ▾" Click="ZoomClick" Background="Transparent"/>
        <Button x:Name="DeviceButton" Content="▣  电脑" Click="DeviceClick" Background="Transparent"/>
        <Button Content="▧  广告模式" Click="AdClick" Background="Transparent"/>
        <Button x:Name="BackgroundMediaButton" Content="后台继续播放：关" Click="BackgroundMediaClick" ToolTip="开启后，老板键隐藏、最小化或切换窗口也继续播放" Background="Transparent"/>
        <Button x:Name="ResumeMediaButton" Content="回到前台自动续播：开" Click="ResumeMediaClick" ToolTip="后台播放关闭时，仅恢复被浮光暂停的媒体；手动暂停不受影响" Background="Transparent"/>
        <Button x:Name="BackdropButton" Content="白底透明：关" Click="BackdropClick" ToolTip="只让白色背景透明；网页可直接点击、输入、滚动，视频控制栏可正常操作。" Background="Transparent"/>
       </WrapPanel>
       <Grid x:Name="FooterStatus" Margin="5,8,0,0"><TextBlock x:Name="Status" Text="就绪" Foreground="#6E868E" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,0,210,0"/><TextBlock x:Name="BossHint" Text="Ctrl + Alt + Q  隐藏 / 召回" Foreground="#7D9996" FontSize="10" HorizontalAlignment="Right"/></Grid>
      </StackPanel>
     </Border>
     <Border x:Name="Overlay" Grid.RowSpan="3" Background="#162229" Padding="30,24" Visibility="Collapsed">
      <DockPanel><Grid DockPanel.Dock="Top" Margin="0,0,0,20"><TextBlock x:Name="OverlayTitle" FontSize="23" FontWeight="SemiBold"/><Button Content="关闭 ×" HorizontalAlignment="Right" Click="DismissOverlay"/></Grid><ScrollViewer x:Name="OverlayScroll" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="OverlayContent"/></ScrollViewer></DockPanel>
     </Border>
    </Grid>
   </Grid>
  </Grid>
 </Border>
</Window>






